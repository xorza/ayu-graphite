// Ayu Graphite, for darkroom — generated. Do not edit by hand.
//
// Source:    ayu-graphite.toml
// Generator: ayu-graphite/darkroom/build.py
//
// Each entry names a role darkroom paints with, the role here it is
// taken from, and the primitive that resolves to. Every colour is a
// resting one: a port lifts under the pointer by blending toward
// white, because the palette's top tint has nothing above it.
//
// The graph ground is the one colour with no step of its own. The
// neutral ramp holds five chrome surfaces and darkroom stacks six, so
// the ground is placed one of that ramp's own steps below `bg`.
(
    // Chrome — the surfaces the editor is built out of, and the inks on them.
    canvas_bg:           "#141414",    // (the ramp's step)  below gray_1
    canvas_dot:          "#454545",    // border             gray_4
    chrome_fill:         "#1f1f1f",    // bg                 gray_1
    tab_inactive:        "#2b2b2b",    // panel              gray_2
    node_fill:           "#383838",    // elem               gray_3
    node_border:         "#00000000",  // (no outline)       the shadow carries the edge
    header_fill:         "#525252",    // elem_active        gray_5
    node_ambient_shadow: "#00000080",  // overlay_black      black
    text:                "#ebebeb",    // text               gray_7
    text_muted:          "#a4a4a4",    // text_muted         gray_6
    text_disabled:       "#a4a4a4",    // text_disabled      gray_6
    elem_hover:          "#454545",    // elem_hover         gray_4
    elem_active:         "#525252",    // elem_active        gray_5
    border_focused:      "#0077b4",    // border_focused     blue_normal

    // Graph — the wires, and the marks drawn over them.
    selection_rect:      "#00abff",    // accent             blue_bright
    connection_broken:   "#ff7763",    // error              red_bright
    breaker_stroke:      "#ff7763",    // error              red_bright

    // Ports — an untyped port's circle, and the ink beside it. A typed port
    // takes its hue from the type table instead.
    input_port:          "#7cdd66",    // success            green_bright
    output_port:         "#ff9000",    // syn_keyword        orange_bright
    event_port:          "#ff7763",    // error              red_bright
    port_label:          "#a4a4a4",    // text_muted         gray_6

    // Badges — what a node's head says about itself.
    badge_graph:         "#00abff",    // accent             blue_bright
    badge_sink:          "#ff7763",    // error              red_bright
    badge_cache:         "#f9de1a",    // warning            yellow_bright
    badge_impure:        "#ebebeb",    // text               gray_7

    // Status — what a node's head says about its last run.
    status_success:      "#7cdd66",    // success            green_bright
    status_info:         "#00abff",    // accent             blue_bright
    status_busy:         "#a4a4a4",    // text_muted         gray_6
    status_warning:      "#ff9000",    // syn_keyword        orange_bright
    status_error:        "#ff7763",    // error              red_bright

    // A wire's hue is the type flowing along it. `ramp` backs the
    // open-ended custom and enum families, keyed by type id.
    type_colors: (
        boolean: "#ff7763",    // error              red_bright
        int:     "#f9de1a",    // ansi_bright_yellow yellow_bright
        float:   "#8d7d00",    // ansi_yellow        yellow_normal
        string:  "#7cdd66",    // syn_string         green_bright
        path:    "#00abff",    // hint               blue_bright
        image:   "#ff9000",    // syn_keyword        orange_bright
        ramp: (
            "#be5648",    // ansi_red           red_normal
            "#0077b4",    // ansi_blue          blue_normal
            "#ebebeb",    // syn_punctuation    gray_7
            "#a4a4a4",    // text_muted         gray_6
        ),
    ),
)
